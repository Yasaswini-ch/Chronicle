{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": ".",
      "framework": "flask",
      "entrypoint": "api/index.py",
      "functions": {
        "api/index.py": {
          "includeFiles": "{src/chronicle/**,data/processed/**,data/annotations/**,data/output/pipeline_results.json}",
          "maxDuration": 30
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
